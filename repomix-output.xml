<file path="src/App.css">
.dashboard-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 32px 20px 48px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 28px;
}

.eyebrow {
  margin: 0 0 8px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 11px;
  color: #5c6b7a;
}

h1 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3rem);
}

.chip {
  background: #e9f2ff;
  color: #1d4ed8;
  border: 1px solid #cfe0ff;
  border-radius: 999px;
  padding: 9px 14px;
  font-size: 12px;
  font-weight: 600;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 18px;
  margin-bottom: 24px;
}

.stat-card,
.panel {
  background: #ffffff;
  border: 1px solid #e6ebf3;
  border-radius: 14px;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
}

.stat-card {
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.stat-card span {
  color: #5c6b7a;
  font-size: 13px;
}

.stat-card strong {
  font-size: 2rem;
}

.panel-grid {
  display: grid;
  grid-template-columns: 1.1fr 1.4fr;
  gap: 20px;
}

.panel {
  padding: 20px;
}

.panel h2 {
  margin: 0 0 18px;
  font-size: 1.2rem;
}

.bars {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.bar-row {
  display: grid;
  grid-template-columns: 120px 1fr 48px;
  align-items: center;
  gap: 12px;
  font-size: 14px;
}

.bar-track {
  width: 100%;
  height: 12px;
  background: #edf2f7;
  border-radius: 999px;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #1d4ed8, #60a5fa);
}

table {
  width: 100%;
  border-collapse: collapse;
}

th,
td {
  text-align: left;
  padding: 12px 10px;
  border-bottom: 1px solid #edf2f7;
  font-size: 14px;
}

th {
  color: #5c6b7a;
  font-size: 12px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

@media (max-width: 760px) {
  .topbar,
  .panel-grid {
    grid-template-columns: 1fr;
    display: grid;
  }

  .topbar {
    gap: 12px;
  }

  .bar-row {
    grid-template-columns: 1fr;
  }
}
</file>

