<file path="src/Comparison.css">
.comparison-section {
  margin-top: 60px;
  padding: 30px;
  background: white;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.comparison-section h2 {
  font-size: 1.8rem;
  margin-bottom: 8px;
  color: #333;
}

.subtitle {
  color: #666;
  font-size: 1rem;
  margin-bottom: 30px;
}

/* Comparison Container */
.comparison-container {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 30px;
  align-items: center;
  margin-bottom: 60px;
}

.comparison-card {
  background: white;
  border: 2px solid #ddd;
  border-radius: 12px;
  padding: 24px;
  position: relative;
}

.comparison-card.dumb {
  border-color: #f56565;
  background: #fff5f5;
}

.comparison-card.smart {
  border-color: #48bb78;
  background: #f0fdf4;
}

.comparison-card h3 {
  font-size: 1.3rem;
  margin-bottom: 8px;
  color: #333;
}

.comparison-card .strategy {
  font-size: 0.9rem;
  color: #666;
  margin-bottom: 20px;
  font-style: italic;
}

.metric {
  margin-bottom: 16px;
  padding: 12px;
  background: rgba(0, 0, 0, 0.02);
  border-radius: 8px;
}

.metric .label {
  font-size: 0.85rem;
  color: #666;
  margin-bottom: 4px;
}

.metric .value {
  font-size: 1.8rem;
  font-weight: bold;
  color: #333;
}

.metric .recovery-rate {
  color: #667eea;
}

.pros-cons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin: 16px 0;
}

.pros strong,
.cons strong {
  display: block;
  margin-bottom: 8px;
  font-size: 0.9rem;
}

.pros {
  color: #22543d;
}

.cons {
  color: #742a2a;
}

.pros ul,
.cons ul {
  list-style: none;
  font-size: 0.85rem;
}

.pros li,
.cons li {
  padding: 4px 0;
  line-height: 1.4;
}

.pros li:before {
  content: "✓ ";
  color: #48bb78;
  font-weight: bold;
}

.cons li:before {
  content: "✗ ";
  color: #f56565;
  font-weight: bold;
}

.false-pos {
  font-size: 0.85rem;
  color: #666;
  padding: 12px;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 6px;
  margin-top: 12px;
}

/* Improvement Arrow */
.improvement-arrow {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
}

.arrow-up {
  font-size: 2rem;
  animation: bounce 1s infinite;
}

@keyframes bounce {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}

.delta {
  text-align: center;
  font-weight: bold;
  color: #48bb78;
  font-size: 0.95rem;
  background: #f0fdf4;
  padding: 12px 16px;
  border-radius: 8px;
  border: 2px solid #48bb78;
}

/* Feedback Loop */
.feedback-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-bottom: 30px;
}

.feedback-card {
  background: #f8f9fa;
  border: 2px solid #ddd;
  border-radius: 12px;
  padding: 20px;
}

.channel-name {
  font-size: 1.1rem;
  font-weight: bold;
